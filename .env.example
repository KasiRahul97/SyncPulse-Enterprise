# ============================================================================
# SyncPulse Enterprise — environment configuration
# Copy this file to `.env` (docker compose reads .env automatically).
# All values below are safe local defaults.
# ============================================================================

# ---- Cassandra ----
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=syncpulse
CASSANDRA_DATACENTER=datacenter1
CASSANDRA_REPLICATION_FACTOR=1

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=syncpulse.playhead.changes
KAFKA_CONSUMER_GROUP=syncpulse-companion

# ---- Debounce policy (Redis Lua) ----
# Persist a ping only if position moved >= threshold seconds
# OR at least this many seconds elapsed since the last persisted ping.
DEBOUNCE_POSITION_THRESHOLD=5
DEBOUNCE_TIME_THRESHOLD=10

# ---- CDC adapter selection: "local" or "debezium" ----
# local    => backend emits a Kafka event immediately after a Cassandra commit
#             (LocalDevelopmentCdcAdapter — clearly labelled, for reproducible demos)
# debezium => backend does NOT emit; a real Debezium connector tails the Cassandra
#             CDC commit log and publishes to Kafka (see infrastructure/debezium)
SYNCPULSE_CDC_MODE=local

# ---- Demo seed data ----
SYNCPULSE_SEED_ENABLED=true

# ---- Ports exposed to the host ----
FRONTEND_PORT=3000
BACKEND_PORT=8080
CONSUMER_PORT=8081

# ---- CORS (comma-separated origins allowed to call the API directly) ----
SYNCPULSE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
